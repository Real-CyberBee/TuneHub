# TuneHub 部署配置示例。
#
# 复制成 deploy/.env.deploy.local 再填真实值；该文件已被 .gitignore 排除，
# 绝不会被提交到开源仓库。也可以直接用同名环境变量覆盖这里的每一项。

# 腾讯云 API 密钥（COS 上传、CDN 刷新、DNSPod 解析、SSL 证书共用一套）。
# 建议用 CAM 子账号，只授予 COS / CDN / DNSPod / SSL 这几项权限。
TENCENTCLOUD_SECRET_ID=
TENCENTCLOUD_SECRET_KEY=

# 静态站点存放的 COS 桶（名字必须全局唯一，格式 <名称>-<APPID>）
TUNEHUB_BUCKET=tunehub-1454836334

# COS 地域
COS_REGION=ap-guangzhou

# 对外访问的加速域名（CDN 回源到上面这个桶的静态网站端点）
TUNEHUB_DOMAIN=music.cyberbee.top

# 主域名（用来加 DNS 解析记录）
TUNEHUB_ROOT_DOMAIN=cyberbee.top

# CDN 加速区域：mainland / overseas / global
TUNEHUB_CDN_AREA=mainland
